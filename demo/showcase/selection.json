    {
      "id": "steering",
      "title": "Steering",
      "kicker": "02",
      "intro": "With a small regressor that predicts a musical attribute, generation can be pushed toward a target without retraining. For the EBT, the regressor's error is added to the energy it already minimises. For the Llama baseline we use PPLM-style guidance: one gradient step on the logits. Targets are 2 standard deviations (of the corpus) below or above the prompt's own unguided level. Each system is shown at its operating point (the strongest setting that keeps dissonance in the range of real music). One pattern to listen for: the EBT moves strongly in one direction per attribute (up for duration and pitch, down for velocity) and only weakly in the other. PPLM moves both ways but often undershoots.",
      "layout": "steer",
      "examples": [
        {
          "title": "Velocity (loudness)",
          "attribute": "velocity",
          "metric": "velocity",
          "metric_label": "mean velocity",
          "metric_unit": "/127",
          "prompt_id": 9235,
          "clips": [
            {
              "id": "steer_vel_ebt_dn",
              "kind": "ebt",
              "attribute": "velocity",
              "prompt": 9235,
              "sd": -2,
              "row": "EBT",
              "col": "down"
            },
            {
              "id": "steer_vel_ebt_un",
              "kind": "baseline",
              "model": "ebt",
              "prompt": 9235,
              "row": "EBT",
              "col": "unguided"
            },
            {
              "id": "steer_vel_ebt_up",
              "kind": "ebt",
              "attribute": "velocity",
              "prompt": 9235,
              "sd": 2,
              "row": "EBT",
              "col": "up"
            },
            {
              "id": "steer_vel_pplm_dn",
              "kind": "pplm",
