    {
      "id": "limits",
      "title": "Pushing too hard",
      "kicker": "03",
      "intro": "Guidance strength is a trade-off. Past the operating point, strong EBT guidance flattens the model's choice among attribute values: the target is reached by scattering near-random notes. Harsh dissonance (share of simultaneous note pairs a semitone, major seventh or tritone apart) rises to the level of uniformly random notes, about 0.25. This is the main limitation we found.",
      "layout": "grid",
      "examples": [
        {
          "title": "Pitch register pushed up, at increasing guidance strength",
          "prompt_id": 3107,
          "clips": [
            {
              "id": "lim_pitch_un",
              "kind": "baseline",
              "model": "ebt",
              "prompt": 3107,
              "label": "Unguided"
            },
            {
              "id": "lim_pitch_op",
              "kind": "ebt",
              "attribute": "pitch_register",
              "prompt": 3107,
              "sd": 2,
              "label": "λ = 0.02",
              "tag": "operating point"
            },
            {
              "id": "lim_pitch_hi",
              "kind": "ebt",
              "attribute": "pitch_register",
              "prompt": 3107,
              "sd": 2,
              "lambda": "0.16",
              "label": "λ = 0.16",
              "tag": "too strong"
            }
          ],
          "metrics": [
            {
              "metric": "pitch",
              "metric_label": "mean pitch",
              "metric_unit": ""
            },
            {
              "metric": "dissonance",
              "metric_label": "harsh dissonance",
              "metric_unit": ""
            }
          ]
